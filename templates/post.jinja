{% macro postBox(title,body,createdOn,postID) %}
<div class="post grid grid-row-6 bg-fuchsia-400 content-center border-y-4 border-gray-950 max-h-[180px] w-screen overflow-hidden hover:bg-fuchsia-300" id={{postID}}>
    <div class="text-center row-span-2 underline row-start-1 row-end-2">
        <p class="text-lg font-serif font-semibold">{{title}}</p>
    </div><br>
    <div class="text-left row-start-2">
        <p class="text-3xs font-[cursive]">{{createdOn}}</p>
    </div>
    <div class="text-left row-span-3 row-start-3 row-end-6">
        {% if body|length <= 15%}
        <p class="text-lg">{{body}}</p>
        {% else %}
        <p class="text-lg">{{body[0:15] + "..."}}</p>
        {%-endif%}
    </div>

</div>
{%- endmacro %}