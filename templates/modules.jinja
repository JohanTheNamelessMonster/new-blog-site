{%macro footer(socials,tools)%}
<div class="fixed grid grid-cols-2 gap-y-2 bg-purple-800 divide-x-2 divide-solid divide-gray-950 bottom-0 w-screen h-full max-h-[125px]">
    <div class="relative grid grid-rows-1 float-left divide-dashed divide-gray-950">
        <div class="relative grid grid-cols-2 gap-x-8 justify-center my-2 h-full">
            <div class="flex items-center space-x-4">
                <a class="float-left relative rounded" href={{socials[0]}}><i class="fa-brands fa-github fa-2xl"></i></a>
                <a class="text-lg font-serif" href={{socials[0]}}>Github</a>
            </div>
            <div class="flex items-center space-x-4">
                <a class="float-left relative rounded size-8 cursor-pointer" id="discord_tag"><i class="fa-brands fa-discord fa-2xl"></i></a>
                <p class="text-lg font-serif cursor-pointer">My Discord Username</p>
            </div>
        </div>
    </div>
    <div class="relative grid grid-rows-5 min-w-1/2 right-0 max-h-[60px]">
        <div class="relative content-center m-0 text-center">
            <h1 class="m-0 text-3xl text-gray-50">Tools Used</h1>
        </div>
        <div class="relative content-center row-start-2 row-end-4 gap-3 h-24 overflow-auto text-center divide-y-{{tools|length}} divide-dashed divide-gray-950">
            {% for i in range(tools|length)%}
            <div>
                <a href={{tools[i][0]}} class="text-gray-50">{{tools[i][1]}}</a>
            </div>
            {%- endfor%}
        </div>
    </div>
</div>
{%- endmacro%}

{% macro navbar(values,urls)%}
    <nav class="sticky bg-purple-800 after:pointer-events-none after:absolute after:inset-x-0 after:bottom-0 after:h-px after:bg-white/10 w-screen">
    <div class="max-w-7xl">
        <div class="relative flex h-16 items-center justify-between">
        <div class="absolute inset-y-0 left-0 flex items-center sm:hidden">
            <!-- Mobile menu button-->
            <button type="button" command="--toggle" commandfor="mobile-menu" class="relative inline-flex items-center justify-center rounded-md p-2 text-gray-400 hover:bg-white/5 hover:text-white focus:outline-2 focus:-outline-offset-1 focus:outline-red-800">
            <span class="absolute -inset-0.5"></span>
            <span class="sr-only">Open main menu</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 in-aria-expanded:hidden">
                <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 not-in-aria-expanded:hidden">
                <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            </button>
        </div>
        <div class="flex flex-1 items-center justify-center sm:items-stretch sm:justify-start">
            <div class="flex shrink-0 items-center">
                <a href="/" class="font-bold text-white">Goutham Nair</a>
            </div>
        </div>
        <div class="absolute inset-y-0 right-0 flex items-center pr-2 sm:static sm:inset-auto sm:ml-6 sm:pr-0">
            <div class="hidden sm:ml-6 sm:block">
            <div class="flex space-x-4">
                <!-- Current: "bg-gray-950/50 text-white", Default: "text-gray-300 hover:bg-white/5 hover:text-white" -->
                {% for i in range(values|length)%}
                    <a href={{urls[i]}} aria-current="page" class="rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-white/5 hover:text-white">{{values[i]}}</a>
                {%- endfor%}
            </div>
            </div>
        </div>
        </div>
    </div>

    <el-disclosure id="mobile-menu" hidden class="block sm:hidden">
        <div class="space-y-1 px-2 pt-2 pb-3">
            {% for i in range(values|length)%}
                <a href={{urls[i]}} aria-current="page" class="rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-white/5 hover:text-white">{{values[i]}}</a>
            {%- endfor%}
        </div>
    </el-disclosure>
    </nav>
{%- endmacro%}

{% macro postBox(title,body,createdOn,postID) %}
<div class="post grid grid-row-6 bg-fuchsia-400 content-center border-y-4 border-gray-950 max-h-[180px] w-screen overflow-hidden hover:bg-fuchsia-300 px-4 mx-16 rounded-xl cursor-pointer" id={{postID}}>
    <div class="text-center row-span-2 underline row-start-1 row-end-2">
        <p class="text-lg font-serif font-semibold">{{title}}</p>
    </div><br>
    <div class="text-left row-start-2">
        <p class="text-3xs font-[cursive]">{{createdOn}}</p>
    </div>
    <div class="text-left row-span-3 row-start-3 row-end-6">
        {% if body|length <= 15%}
        <p class="text-lg">{{body}}</p>
        {% else %}
        <p class="text-lg">{{body[0:15] + "..."}}</p>
        {%-endif%}
    </div>

</div>
{%- endmacro %}