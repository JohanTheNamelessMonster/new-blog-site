{% macro navbar()%}
    <nav id="navigationBar">
        <div id="menuButtonBox">
            <i id="hamburgerButton" class="fa-solid fa-bars fa-2x fa-inverse"></i>
        </div>
        <div id="titleBox">
            <h1 id="title">Goutham Nair</h1>
        </div>
    </nav>
{%- endmacro%}

{% macro postBox(title,body,createdOn,createdAt,postID) %}
    <div class="postBox cursor-pointer" id={{postID}}>
        <div id="postTitle">
            <h1>{{title}}</h1>
        </div>
        <div id="postCreationTime" class="text-gray-500 py-2 ml-4">
            <p>Created {{createdOn}} at {{createdAt}}</p>
        </div>
        <div id="postBodySnippet" class="text-gray-500 ml-4">
            <p>{{body}}</p>
        </div>
    </div>
{%- endmacro %}

{% macro pagesMenu(values,urls) %}

    <div class="flex">
        <div id="menuCollapseButton">
            <i class="fa-solid fa-x fa-2x fa-inverse"></i>
        </div>
        <div id="titleBox">
            <h1 id="title">Goutham Nair</h1>
        </div>
    </div>
    <div id="pageLinksBox">
        {% for i in range(values|length)%}
            <a href={{urls[i]}} id="Page">{{values[i]}}</a>
        {%- endfor %}
    </div>

{%- endmacro %}

{% macro socialBox(platform,icon,descriptor) %}

    <div id="infoBox" class="grid w-1/2 mx-8 cursor-pointer {{platform}}">
        <div class="flex items-center mt-2">
            <div>
                <i class="{{icon}} fa-2x w-3/10 ml-4"></i>
            </div>
            <div class="w-full">
                <h1 id="infoTitle" class="text-center">{{platform}}</h1>
            </div>
        </div>
        <div>
            <p id="socialText">{{descriptor}}</p>
        </div>
    </div>
{%- endmacro %}